# Backend đọc key này khi chạy local. Trên Vercel, tạo biến cùng tên trong Settings.
OPENWEATHER_API_KEY=dien_api_key_cua_em_o_day

# Frontend dùng localhost khi học local. Sau khi deploy backend, thay bằng URL Vercel.
API_URL=http://localhost:8000

# Frontend dùng key này để gọi Gemini cho tab Trợ lý thời tiết AI.
GEMINI_API_KEY=dien_gemini_api_key_cua_em_o_day

